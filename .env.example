# Copy to .env.
# POSTGRES_USER=recon
# POSTGRES_PASSWORD=recon
# POSTGRES_DB=recon

# Used when running the API outside Docker (from backend/).
# DATABASE_URL=postgresql://recon:recon@localhost:5432/recon

# Docker only: host ports. Change these if something on your machine already uses 5432/8000
# (for example a native PostgreSQL install). Containers talk to each other on the usual ports.
# DB_HOST_PORT=5433
# API_HOST_PORT=8001

# AI features (optional). Without a key the app uses rules only. Never commit a real key.
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_REASONING_FORMAT=hidden   # reasoning models only; empty for others
# GROQ_REASONING_EFFORT=low      # none | low | medium | high
# GROQ_TEMPERATURE=0.3
# GROQ_MAX_TOKENS=4000
# GROQ_TPM_LIMIT=7000            # tokens per minute to stay under; 0 = no pacing (paid plans)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Demo passwords
# DEMO_EXEC_PASSWORD=
# DEMO_COFOUNDER_PASSWORD=

# Uploads
# UPLOAD_DIR=/tmp/recon_uploads
# MAX_UPLOAD_MB=100
# MAX_UNZIPPED_MB=1024

# AI mapping suggestions per person per 10 minutes
# AI_SUGGESTIONS_PER_10MIN=10

# Behind a reverse proxy only: addresses whose X-Forwarded-For can be believed
# TRUSTED_PROXIES=

# Production: APP_ENV=production turns off /docs and sets Secure cookies
# APP_ENV=development